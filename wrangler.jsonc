{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tandem",
  "compatibility_date": "2026-11-17",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tandem",
      "database_id": "5b3a552a-2e3a-44d2-bd5c-948509dad695",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access team domain and application audience tag (not secrets).
    // Empty means every request is refused. ALLOWED_EMAILS is a Worker secret,
    // never in this file.
    "ACCESS_TEAM_DOMAIN": "https://noisy-poetry-5afe.cloudflareaccess.com",
    "ACCESS_AUD": "a5f254817aa4cf2238e3a86f1f2ed66fa743a901e5604d5f62c96f2717daeb9f"
  },
  // Attachment bytes. Metadata lives in D1; this holds the files themselves.
  "kv_namespaces": [
    {
      "binding": "ATTACHMENTS",
      "id": "a67644e43967447585470c95341a26c7"
    }
  ]
}
